# Copie este arquivo pra .env.local (dev) e cadastre os mesmos nomes nas
# Environment Variables do projeto na Vercel (Production, Preview e
# Development) — variáveis definidas só localmente NÃO valem em produção.
# Isso já causou duas quedas de produção nesta sessão (CREDENTIALS_ENCRYPTION_KEY
# e PLATFORM_ADMIN_EMAILS ausentes na Vercel), então mantenha isso atualizado
# sempre que uma variável nova for adicionada ao código.

# --- Backend FastAPI (Gerenciamento de Empresas) — opcional ---
BACKEND_API_URL=http://localhost:8000/api/v1
BACKEND_ADMIN_KEY=

# --- Criptografia de credenciais (Meta, IA por conta) ---
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA trocar em produção depois de já ter dados salvos — invalida tudo que
# foi criptografado com o valor anterior.
CREDENTIALS_ENCRYPTION_KEY=

# --- Admin de plataforma ---
# E-mails separados por vírgula, sem espaço.
PLATFORM_ADMIN_EMAILS=

# --- Meta / WhatsApp (Global do App — um único App Dashboard pra todas as contas) ---
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
NEXT_PUBLIC_META_GRAPH_API_VERSION=v21.0
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
# Precisa bater com o Verify Token cadastrado no Webhook do App Dashboard —
# é o único usado na prática (não é por conta, mesmo existindo um campo
# parecido no MetaAccess de cada conta).
META_WEBHOOK_VERIFY_TOKEN=

# --- Google Calendar (sync de agenda dos profissionais) ---
# console.cloud.google.com → APIs & Serviços → Credenciais → OAuth Client ID
# GOOGLE_REDIRECT_URI precisa bater EXATAMENTE com uma Authorized redirect URI
# cadastrada no client OAuth — e MUDA entre local (localhost) e produção (domínio real).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/agenda/google/callback

# --- Firebase Client SDK (público, prefixo NEXT_PUBLIC_) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (privado — nunca exponha no client) ---
# Firebase Console → Configurações do projeto → Contas de serviço → Gerar nova chave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- App ---
# MUDA entre local (localhost) e produção (domínio real).
NEXT_PUBLIC_APP_URL=http://localhost:3000
