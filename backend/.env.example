# Copie pra ".env" (dev local) e cadastre os mesmos nomes onde o backend
# for hospedado em produção (ex: Cloud Run → Variables & Secrets).
# Precisa bater 1:1 com backend/app/core/config.py (Settings) — atualize
# este arquivo sempre que um campo novo for adicionado lá.

# --- App ---
APP_NAME="WhatsApp SaaS Backend"
ENVIRONMENT=development
DEBUG=true

# --- Firebase / Firestore ---
FIREBASE_PROJECT_ID=
# Caminho pro JSON do service account — usar em dev local. Em produção
# (Cloud Run/GKE), deixe vazio: cai em Application Default Credentials,
# usando a service account anexada ao serviço.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
# Banco Firestore NOMEADO (mesmo usado pelo web/, não é o "(default)")
FIRESTORE_DATABASE_ID=zybot-data

# --- Segurança / Criptografia ---
# Fernet (32 bytes url-safe base64). Gere com:
# python -c "from app.core.security import generate_encryption_key; print(generate_encryption_key())"
# NUNCA trocar depois de já ter dados reais salvos — invalida tudo que foi
# criptografado com o valor anterior (access_token da Meta, api_key da IA).
ENCRYPTION_KEY=

# --- Meta / WhatsApp Cloud API ---
# Mesmo App Dashboard usado pelo web/ — precisam ser os MESMOS valores de
# META_APP_SECRET/META_WEBHOOK_VERIFY_TOKEN em web/.env.local.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v20.0

# --- CORS ---
# Lista JSON de origens permitidas — inclua o domínio de produção do web/.
CORS_ORIGINS=["http://localhost:3000"]

# --- Logging ---
LOG_LEVEL=INFO

# --- Admin de plataforma ---
# Chave compartilhada com BACKEND_ADMIN_KEY em web/.env.local — precisa ser
# EXATAMENTE igual nos dois lados, senão o CRM de Empresas e o
# encaminhamento de mensagens do WhatsApp param de autenticar.
PLATFORM_ADMIN_API_KEY=
